PORT=4100
HOST=localhost
APP_BASE_URL=http://localhost:4100

JWT_SECRET=replace-with-a-long-random-secret

# Persistence
# `json` keeps the local JSON store as the source of truth.
# `postgres` makes core finance domains use PostgreSQL as the authoritative store.
TR_PERSISTENCE_MODE=json
TR_DATABASE_URL=
TR_PSQL_BIN=psql

# Google OAuth (optional for production-safe verification)
GOOGLE_CLIENT_ID=

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Use `sandbox` for localhost development.
# Use `production` only when APP_BASE_URL / QBO_REDIRECT_URI point to an HTTPS deployed host.
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:4100/api/qbo/callback
QBO_SCOPE=com.intuit.quickbooks.accounting
QBO_WEBHOOK_VERIFIER_TOKEN=

# SMTP (optional; if blank, notifications are simulated as SENT)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@telerelation.local
